{
  "name": "nightcode",
  "version": "0.1.1",
  "private": true,
  "description": "A terminal-based AI coding agent powered by NVIDIA's free model catalog.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Rishikesh Palande (@RISHII7)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RISHII7/night-code.git"
  },
  "bugs": {
    "url": "https://github.com/RISHII7/night-code/issues"
  },
  "homepage": "https://github.com/RISHII7/night-code#readme",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "build:cli": "bun build packages/cli/src/index.tsx --outdir packages/cli/dist --target bun",
    "build": "bun run build:cli",
    "typecheck": "tsc --noEmit -p packages/cli/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "commitlint": "commitlint --config commitlint.config.mjs",
    "commitlint:branch": "commitlint --config commitlint.config.mjs --from origin/develop --to HEAD"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.18.0",
    "@types/bun": "latest",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
