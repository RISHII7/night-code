# ---------------------------------------------------------------------------
# NightCode environment configuration
#
# Copy this file to `.env` and fill in the values. Never commit a populated
# `.env` — it is gitignored for a reason.
#
# Full reference, including setup order and where each value comes from:
#   docs/14-environment-configuration.md
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Base URL the CLI targets, and the base used to build the OAuth redirect URI.
API_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. Use the POOLED connection string in deployed
# environments; the direct connection string is for migrations only.
DATABASE_URL=

# --- AI inference providers -------------------------------------------------
# NVIDIA NIM powers the free tier. Server-held only — never shipped to the CLI.
NVIDIA_API_KEY=

# Premium (Pro-tier) providers. Optional in local development if you are only
# exercising free-tier models.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Identity (Clerk) -------------------------------------------------------
CLERK_FRONTEND_API=
CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_CLIENT_SECRET=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Signing secret for internally issued short-lived tokens.
# Generate with: openssl rand -base64 32
JWT_SECRET=

# --- Billing & usage metering (Polar) ---------------------------------------
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
# `sandbox` for local and preview environments, `production` for live billing.
POLAR_SERVER=sandbox
POLAR_USAGE_METER_ID=

# --- Observability (optional in local development) --------------------------
SENTRY_DSN=
